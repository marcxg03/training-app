# Supabase — public client values
# Browser-safe. NEXT_PUBLIC_ prefix exposes them to the client bundle.
# Source: Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only secret
# NEVER ship to the client. Used by the seed script
# (supabase/seed/seed-from-wiki.ts) and by the coaching data layer
# (src/lib/supabase/admin.ts) to read a client's own data for coach
# analytics AFTER the coach↔client relationship is verified.
# Source: Supabase project dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — server-only secret (optional)
# Enables the AI photo macro estimator on the Nutrition tab (Slice 14).
# When unset, the photo button is hidden and macros are entered manually.
# Uploaded meal photos are sent to Anthropic for estimation.
# Source: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Coaching feature flag — client-visible (optional)
# Coaching is now backed by Supabase (migration 021_coaching.sql). Leave UNSET
# (or anything other than "true") to keep the coach routes redirecting away and
# the persona switcher hiding "Coaching". Set to "true" to enable coaching —
# ONLY after migration 021 is applied and its RLS has been verified live
# (see KNOWN_ISSUES.md).
NEXT_PUBLIC_COACHING_ENABLED=

# Seed script — optional target user override
# If not set, the seed script looks up the single profile row in
# the database. Set this to the auth.users.id UUID when more than
# one profile exists.
SEED_TARGET_USER_ID=
