# Supabase — public client values
# Browser-safe. NEXT_PUBLIC_ prefix exposes them to the client bundle.
# Source: Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only secret
# NEVER ship to the client. Used only by the seed script
# (supabase/seed/seed-from-wiki.ts).
# Source: Supabase project dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Seed script — optional target user override
# If not set, the seed script looks up the single profile row in
# the database. Set this to the auth.users.id UUID when more than
# one profile exists.
SEED_TARGET_USER_ID=
